#!/bin/sh /etc/rc.common
# ACE —— WARP/AmneziaWG 客户端在 OpenWrt 上的服务封装。
#
# 设计要点（都是在真机上踩过的坑）：
#   * 引擎自己就是长驻进程（connect 不返回，直到断开），所以交给 procd 看护，
#     崩溃自动拉起，停止时先喊一声 disconnect 再杀，避免残留内核占端口。
#   * TUN 模式不碰 dnsmasq 的 53 端口：内核的解析器听 127.0.0.1:7874，dnsmasq
#     被指到那里。这样隧道没起来时，局域网照常解析，不会整屋断网。
#   * 防火墙用独立 zone（ace0 + masq），由隧道就绪后动态添加，断开时移除。

START=99
STOP=10
USE_PROCD=1

ACE_HOME=/etc/ace
ACE_BIN=/usr/bin/ace-engine
ACE_STATE=$ACE_HOME/state.json
ACE_LOG=/var/log/ace.log
DNS_BAK=$ACE_HOME/dns.bak
TUN_DEV=ace0
DNS_PORT=7874
WATCH_FLAG=/var/run/ace-watchdog
# 就绪标记：post_up 加完防火墙 zone 后 touch。引擎 adoptTun 等它出现才宣告
# connected —— 防火墙没落地就宣告成功，LAN→TUN 转发全被 fw4 丢弃（2026-11-19
# 第三次断网事故的直接原因）。
ACE_READY=/var/run/ace-ready
WATCH_LOG=/var/log/ace-watchdog.log
ACE_LOCK=/var/run/.ace.lock
ACE_PENDING=/var/run/ace.pending

. /lib/functions.sh

cfg_get() { uci -q get "ace.main.$1"; }

is_on() { [ "$(cfg_get "$1")" = "1" ]; }

# start/stop 串行化:LuCI 连点、轮询重试或 procd 重入会让多个实例并发跑
# dnsmasq restart + uci commit,多个进程抢 /var/run/uci.lock 会互锁、越堆越卡
# (真机实测堆 7 个 stop 就卡到 40s 不返回,点「断开」的 HTTP 一直挂着)。
# 用 mkdir 原子锁(不依赖 util-linux 的 flock 命令,OpenWrt base 未必带):
# mkdir 要么成功要么不存在,天然互斥;锁目录里记持有者 pid,进程崩了可识别过期锁。
take_lock() {
	local tries=50 pid
	# 过期锁:持有者已死(/proc/<pid> 没了)、或目录里根本没写上 pid(写 pid 前
	# 崩溃,这种锁永远等不到过期),都直接清掉重抢,避免一次崩溃锁死服务
	while [ -d "$ACE_LOCK" ]; do
		pid=$(cat "$ACE_LOCK/pid" 2>/dev/null)
		if [ -z "$pid" ] || [ ! -d "/proc/$pid" ]; then
			rm -f "$ACE_LOCK/pid" 2>/dev/null
			rmdir "$ACE_LOCK" 2>/dev/null
			continue
		fi
		tries=$((tries-1))
		[ $tries -le 0 ] && {
			logger -t ace "ace: 另一个 start/stop 正在进行,本次跳过"
			return 1
		}
		sleep 0.5
	done
	mkdir "$ACE_LOCK" 2>/dev/null || return 1
	echo $$ > "$ACE_LOCK/pid" 2>/dev/null
	return 0
}

drop_lock() {
	rm -f "$ACE_LOCK/pid" 2>/dev/null
	rmdir "$ACE_LOCK" 2>/dev/null
}

# ---------------------------------------------------------------- DNS 接管
# dnsmasq 的上游改指向内核解析器。备份只做一次，且记下 noresolv 的原值——
# 用户的 dnsmasq 可能本来就有自定义上游，断开时必须原样还回去。
dns_backup() {
	[ -f "$DNS_BAK" ] && return 0
	{
		printf 'noresolv=%s\n' "$(uci -q get dhcp.@dnsmasq[0].noresolv)"
		uci -q get dhcp.@dnsmasq[0].server | while read -r s; do
			[ -n "$s" ] && printf 'server=%s\n' "$s"
		done
		# 记录原解析器地址，还原时用来核对
		printf 'resolv=%s\n' "$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf 2>/dev/null)"
	} > "$DNS_BAK"
}

dns_apply() {
	dns_backup
	uci -q delete dhcp.@dnsmasq[0].server
	uci -q add_list dhcp.@dnsmasq[0].server="127.0.0.1#$DNS_PORT"
	uci -q set dhcp.@dnsmasq[0].noresolv=1
	uci -q commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	logger -t ace "dnsmasq 上游已指向 127.0.0.1#$DNS_PORT"
}

dns_restore() {
	[ -f "$DNS_BAK" ] || return 0
	local noresolv="" servers=""
	while IFS='=' read -r k v; do
		case "$k" in
			noresolv) noresolv="$v" ;;
			server) servers="$servers $v" ;;
		esac
	done < "$DNS_BAK"

	uci -q delete dhcp.@dnsmasq[0].server
	for s in $servers; do
		uci -q add_list dhcp.@dnsmasq[0].server="$s"
	done
	if [ -n "$noresolv" ]; then
		uci -q set dhcp.@dnsmasq[0].noresolv="$noresolv"
	else
		uci -q delete dhcp.@dnsmasq[0].noresolv
	fi
	uci -q commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	rm -f "$DNS_BAK"
	logger -t ace "dnsmasq 上游已还原"
}

# ---------------------------------------------------------------- 防火墙
# fw4 的 zone 是唯一既能放行 forward 又能做 masquerade 的地方；用 include 往
# chain 里塞规则会和 fw4 自己的链顺序打架。
fw_zone_add() {
	uci -q get firewall.ace >/dev/null 2>&1 && return 0
	uci set firewall.ace=zone
	uci set firewall.ace.name='ace'
	uci set firewall.ace.device="$TUN_DEV"
	uci set firewall.ace.input='ACCEPT'
	uci set firewall.ace.output='ACCEPT'
	uci set firewall.ace.forward='ACCEPT'
	uci set firewall.ace.masq='1'
	uci set firewall.ace.mtu_fix='1'

	uci add firewall forwarding >/dev/null
	uci set firewall.@forwarding[-1].src='lan'
	uci set firewall.@forwarding[-1].dest='ace'

	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	logger -t ace "已添加防火墙 zone（$TUN_DEV，masq）"
}

fw_zone_del() {
	uci -q get firewall.ace >/dev/null 2>&1 || return 0
	# 收集全部指向 ace 的 forwarding 后逆序删除。之前只删第一个就 break，
	# 历史残留会让 fw4 加载报 "references unknown destination"，最坏连累
	# 整份防火墙（含 WAN）加载失败。
	local idx
	for idx in $(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\(@forwarding\[[0-9]*\]\)=forwarding$/\1/p"); do
		[ "$(uci -q get "firewall.$idx.dest")" = "ace" ] && uci -q delete "firewall.$idx"
	done
	uci delete firewall.ace
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	logger -t ace "已移除防火墙 zone"
}

# ---------------------------------------------------------------- 失联自愈
# 踩过的坑：真机上跑 tun 之后，Mac 侧 en0 直接没载波，路由器 IP 不可达，
# WAN 却还活着——交换芯片/驱动挂了，用户进程完全正常，只能人工断电。
# 这个看门狗就是替人拔电源：LAN 曾经通、之后连续三次读不到载波，就 reboot。
# 触发条件加了「隧道还在」：ace0 没了说明是正常断开流程，不是故障。
# 「拔网线」和「驱动假死」从路由器侧无法区分，误拔 60 秒也会重启——
# 不想用就把 lan_watchdog 设 0，或把 watchdog_action 设成 none（只记录）。
lan_watchdog() {
	local seen=0 bad=0 c
	logger -t ace "LAN 看门狗已启动（br-lan 载波监测）"
	while sleep 20; do
		[ -f "$WATCH_FLAG" ] || { logger -t ace "LAN 看门狗退出"; return 0; }
		c=$(cat /sys/class/net/br-lan/carrier 2>/dev/null)
		[ -z "$c" ] && continue
		if [ "$c" = "1" ]; then
			seen=1; bad=0; continue
		fi
		[ "$seen" = "1" ] || continue
		bad=$((bad + 1))
		logger -t ace "br-lan 载波丢失（第 $bad 次）"
		if [ "$bad" -ge 3 ]; then
			if ! ip link show "$TUN_DEV" >/dev/null 2>&1; then
				logger -t ace "载波丢失但隧道已不在，按正常断开处理，看门狗退出"
				return 0
			fi
			local action
			action=$(cfg_get watchdog_action); action=${action:-reboot}
			if [ "$action" = "none" ]; then
				logger -t ace "br-lan 载波连续丢失（watchdog_action=none，仅记录不重启）"
				continue
			fi
			echo "[$(date '+%F %T')] br-lan 载波连续丢失，重启路由器自愈" >> "$WATCH_LOG"
			logger -t ace "br-lan 载波连续丢失，重启路由器自愈"
			sync
			reboot
		fi
	done
}

# 探测内核解析器是否在监听。netstat 在精简 busybox 上可能没编入，
# 依次退化到 ss、/proc/net/tcp（端口转成十六进制，state 0A = LISTEN）。
resolver_listening() {
	local hex
	hex=$(printf '%04X' "$DNS_PORT" 2>/dev/null)
	if command -v netstat >/dev/null 2>&1; then
		netstat -ln 2>/dev/null | grep -qE "(127\.0\.0\.1|0\.0\.0\.0|\*):$DNS_PORT[[:space:]]"
	elif command -v ss >/dev/null 2>&1; then
		ss -ltn 2>/dev/null | grep -qE "(127\.0\.0\.1|0\.0\.0\.0|\*):$DNS_PORT[[:space:]]"
	elif [ -n "$hex" ] && [ -r /proc/net/tcp ]; then
		grep -qiE "(0100007F|00000000):$hex" /proc/net/tcp 2>/dev/null || \
		grep -qiE "(0100007F|00000000):$hex" /proc/net/tcp6 2>/dev/null
	else
		return 1
	fi
}

# ---------------------------------------------------------------- 就绪钩子
# connect 是长跑进程，procd 起来就返回了。隧道真正可用的时刻只能等：
# tun 设备出现 + 内核解析器在听，之后才有必要改 dnsmasq 和防火墙。
post_up() {
	local i=0
	# 900 秒而不是 180：connect 首次运行要先下载分流数据（geo，约 12 MB，
	# 直连 GitHub 可能要几分钟）再扫描、连接、建 TUN —— 180 秒窗口在真机上
	# 会在 ace0 出现前几十秒放弃，之后防火墙 zone 永远不会再加，整屋流量被
	# fw4 丢弃（2026-11-19 第三次断网事故）。等待期间 flag 没了立刻收手。
	while [ "$i" -lt 900 ]; do
		# 用户可能在这几十秒里点了断开：WATCH_FLAG 没了就立刻收手，
		# 否则 stop 清完 zone/DNS 后我们又给加回去（真竞态，不是理论）。
		[ -f "$WATCH_FLAG" ] || { logger -t ace "post_up: 服务已停止，取消接管"; return 0; }
		if ip link show "$TUN_DEV" >/dev/null 2>&1; then
			# 解析器真的在听才改 dnsmasq。之前不管探没探到都往下走，
			# 一旦失败 dnsmasq 上游指向死端口、整屋解析瘫痪（且断电重启
			# 没人还原，见 start_service 里的 dns.bak 兜底）。
			local j=0 resolver_up=0
			while [ "$j" -lt 40 ]; do
				if resolver_listening; then
					resolver_up=1
					break
				fi
				j=$((j + 1)); sleep 0.5
			done
			if [ "$resolver_up" = "1" ]; then
				is_on dns_takeover && dns_apply
			else
				logger -t ace "内核解析器未监听，跳过 DNS 接管（局域网解析不受影响）"
			fi
			fw_zone_add
			# 流表里已有的连接还走老路由，清掉让它们重新选路
			command -v conntrack >/dev/null 2>&1 && conntrack -F >/dev/null 2>&1
			logger -t ace "隧道就绪：$TUN_DEV 已建立"
			# 告诉引擎接管层已就绪，它要验证局域网数据面后才宣告 connected
			touch "$ACE_READY"

			# 死手开关：隧道起来了但确实不通时，宁可自己断开也不要让整屋
			# 挂在一个"显示已连接"的假象上。三次机会，每次间隔 15 秒。
			local k=0
			while [ "$k" -lt 3 ]; do
				if wget -q -T 8 -O /dev/null https://www.gstatic.com/generate_204 2>/dev/null \
					|| wget -q -T 8 -O /dev/null http://www.gstatic.com/generate_204 2>/dev/null; then
					logger -t ace "出口可用，会话保持"
				if [ "$(cfg_get lan_watchdog)" != "0" ]; then
					( lan_watchdog ) 1000>&- &
				fi
					return 0
				fi
				k=$((k + 1)); sleep 15
			done
			logger -t ace "隧道建立后仍不可达，自动断开以免影响局域网"
			echo "[$(date '+%F %T')] 自检失败：隧道不可达，自动断开" >> /var/log/ace.log
			/etc/init.d/ace stop
			return 1
		fi
		i=$((i + 1))
		sleep 1
	done
	logger -t ace "900 秒内未等到 $TUN_DEV，停止服务（不留下接管了一半的假连接）"
	# 放弃接管不等于结束：引擎还在跑、guard 还在守，服务会一直挂着「已连接」。
	# 直接走完整 stop（幂等），把 dns/防火墙/路由全部还原——宁可自己下线。
	/etc/init.d/ace stop
	return 1
}

# ---------------------------------------------------------------- 服务主体
start_service() {
	take_lock || { logger -t ace "ace: 无法获取锁，启动请求已跳过"; return 1; }
	# 告诉界面「正在朝 up 走」,api_status 据此显示处理中(隧道还在后台建时尤其有用)
	echo up > "$ACE_PENDING" 2>/dev/null
	mkdir -p "$ACE_HOME" /var/log

	# 残留兜底：上一次引擎崩溃/断电时 stop 没跑成，dns.bak 还在而 dnsmasq
	# 上游还指着本服务要用的解析器端口。现在引擎尚未启动，必须先还原，
	# 否则整屋 DNS 挂在死端口上等隧道起来——隧道起不来就永久瘫痪。
	if [ -f "$DNS_BAK" ]; then
		logger -t ace "发现上次未还原的 DNS 备份，先恢复 dnsmasq"
		dns_restore
	fi

	local proto ovpn region mport aport core
	proto=$(cfg_get proto); proto=${proto:-awg}
	mport=$(cfg_get mixed_port); mport=${mport:-7890}
	aport=$(cfg_get api_port); aport=${aport:-9090}
	core=$(cfg_get core); core=${core:-/usr/bin/mihomo}

	# 上一轮如果没清干净（被 kill -9、断电、或 stop 没跑完），先收一遍，
	# 否则内核抢不到端口 —— 真机上表现为每轮 connect 直接 "port in use" 失败。
	kill_guard
	kill_connect
	[ -x "$ACE_BIN" ] && "$ACE_BIN" disconnect -mixed-port "$mport" -core "$core" >/dev/null 2>&1
	kill_core

	procd_open_instance ace
	procd_set_param command /usr/share/ace/run.sh
	procd_set_param env WARP_CLIENT_HOME="$ACE_HOME" ACE_DNS_PORT="$DNS_PORT" \
		ACE_LAN_BYPASS="1"
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 25
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance

	# 就绪钩子只在 TUN 模式下有意义（没有 TUN 就没有要接管的东西）。
	# 关键:先 drop_lock 再 fork——post_up 是后台长跑(等隧道+探活,几十秒),
	# 若继承锁 fd 会一直占着,它内部失败时调 stop 就拿不到锁死等 25s。
	# 本函数的同步部分(disconnect+procd 配置)到此已跑完,锁该还了。
	# pending 标记保留到隧道真正就绪/连接断开才清——它要覆盖整个 post_up 期间。
	if [ "$(cfg_get tun)" = "1" ]; then
		: > "$WATCH_FLAG"
		rm -f "$ACE_READY"
	fi
	drop_lock
	if [ "$(cfg_get tun)" = "1" ]; then
		# 1000>&- 同样必须做:rc.common 在 source procd.sh 时就调 procd_lock,
		# 在脚本 shell 里打开 fd 1000 持有 /var/lock/procd_ace.lock 的 flock。
		# post_up 是后台长跑,若继承这个 fd,procd 的锁就永远放不掉——之后所有
		# init.d 动作(含 LuCI 的启动/停止按钮)都会在 procd_lock 里永久阻塞
		# (真机实测 13:45 启动的看门狗 shell 占锁 4 小时,期间 status/enabled
		# 全部挂死)。这里连同 lan_watchdog 一起显式关闭 fd 1000。
		( post_up ) 1000>&- &
	fi
}

# ---------------------------------------------------------------- 停止兜底
# 2026-11-18 事故：openvpn 试跑后点「停止」无效，最后人工 kill 进程才恢复。
# 三处漏网，全部来自「收尾依赖某个进程正常退出」：
#   1. guard 看守进程不是 procd 的子进程，stop 碰不到它；它发现会话没数据面
#      就去轮换端点重建会话 —— 于是隧道自己又起来了，用户看到的就是「停不掉」。
#   2. mihomo 被强杀后变孤儿，继续占着 7890/9090，之后每轮 connect 都报
#      "port in use"，形成一直失败一直占资源的死循环。
#   3. dnsmasq 上游停在 127.0.0.1#7874，而 7874 已无人监听 —— 全屋 DNS 瘫痪，
#      比断网更狠，连管理页都打不开。原来只在 dns_takeover=1 时还原，
#      且挂在 disconnect 正常返回之后，进程被 kill -9 就永远不会执行。
# 这四步必须自己做、必须幂等、必须与 disconnect 成功与否无关。

# 按命令行找 pid。用 [x] 写法，避免 grep 匹配到执行这段脚本的 shell 自己。
pid_match() {
	ps w 2>/dev/null | grep "$1" | grep -v grep | awk '{print $1}'
}

kill_guard() {
	local p
	for p in $(pid_match "[a]ce-engine guard"); do
		kill -9 "$p" 2>/dev/null && logger -t ace "已终止残留的 guard 进程 $p"
	done
	# 归属文件留着会让下一次 connect 认为「已有人负责健康检查」而不再起守护
	rm -f "$ACE_HOME/.health-owner" /var/run/ace-health-owner 2>/dev/null
}

# 主进程自己走 TERM：引擎收到信号后会跑收尾（删 TUN、停内核、清状态），
# 比外面 kill -9 干净得多。只有它卡住不退才强杀。
# 为什么 stop 要管这个：procd 只停它自己记录的实例，而端口/参数与 uci 不一致的
# 实例（手工调试起的、改过端口后残留的）procd 根本不认识，光靠 disconnect 也
# 匹配不到 —— 真机验证时 connect 就这么活下来了。
kill_connect() {
	local p i=0
	for p in $(pid_match "[a]ce-engine connect"); do
		kill "$p" 2>/dev/null
	done
	while [ "$i" -lt 6 ]; do
		[ -z "$(pid_match "[a]ce-engine connect")" ] && return 0
		i=$((i + 1)); sleep 0.5
	done
	for p in $(pid_match "[a]ce-engine connect"); do
		kill -9 "$p" 2>/dev/null && logger -t ace "connect 未在 3 秒内退出，强制终止 $p"
	done
}

kill_core() {
	local p cmd
	for p in $(pid_match "[m]ihomo"); do
		# busybox 的 tr 只认八进制转义，"\0" 在部分版本上会被当字面量
		cmd=$(tr '\000' ' ' < "/proc/$p/cmdline" 2>/dev/null)
		# 只杀本服务起的：命令行里必须带 ace 的工作目录，用户自己的 mihomo 不碰
		case "$cmd" in
			*ace*)
				kill -9 "$p" 2>/dev/null && logger -t ace "已终止残留的内核进程 $p"
				;;
		esac
	done
}

cleanup_routes() {
	# TUN 留着就会把整屋流量导进黑洞，而且比断网更难查（能 ping 网关、别的一概不通）
	if ip link show "$TUN_DEV" >/dev/null 2>&1; then
		ip link del "$TUN_DEV" 2>/dev/null && logger -t ace "已删除残留隧道设备 $TUN_DEV"
	fi
	# 内核 auto-route 建的策略路由指向 table 2022。TUN 设备被删时路由会跟着走，
	# 但 ip rule 不会 —— 残留规则留着会让流量去查一张空表。
	local pref
	for pref in $(ip rule show 2>/dev/null | awk '$0 ~ /lookup 2022/ {sub(":", "", $1); print $1}'); do
		ip rule del pref "$pref" 2>/dev/null && logger -t ace "已删除残留策略路由 $pref"
	done
}

# 不看备份文件，只看现状：上游还指着本服务的解析器端口，就说明接管没退干净。
# 这一条是兜底里的兜底 —— dns.bak 可能没写成功，也可能被上一次崩溃吃掉。
dns_panic_restore() {
	uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "127.0.0.1#$DNS_PORT" || return 0
	logger -t ace "dnsmasq 仍指向已停止的解析器，强制还原上游"
	uci -q delete dhcp.@dnsmasq[0].server
	uci -q delete dhcp.@dnsmasq[0].noresolv
	uci -q commit dhcp
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
}

stop_service() {
	# 拿不到锁必须报错而不是当成功：否则 LuCI 显示已断开、实际隧道还在跑
	take_lock || { logger -t ace "ace: 无法获取锁，停止失败，请稍后重试"; return 1; }
	local mport core
	mport=$(cfg_get mixed_port); mport=${mport:-7890}
	core=$(cfg_get core); core=${core:-/usr/bin/mihomo}

	# 第一件事就是掐看守进程。放在 disconnect 之后会被它抢先重建会话。
	kill_guard
	# 再让主进程自己退：它跑完收尾，TUN 和内核就顺带清掉了
	kill_connect

	# 正常断开：清端口、还原系统状态（主进程已退时这里主要是补状态文件）
	[ -x "$ACE_BIN" ] && "$ACE_BIN" disconnect -mixed-port "$mport" -core "$core" >/dev/null 2>&1

	# 以下全部幂等，且不依赖上面是否成功
	kill_core
	cleanup_routes
	[ -f "$DNS_BAK" ] && dns_restore
	dns_panic_restore
	fw_zone_del
	rm -f "$WATCH_FLAG" "$ACE_READY"
	drop_lock
	logger -t ace "服务已停止"
}

service_triggers() {
	procd_add_reload_trigger ace
}
